<Window x:Class="cw1_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw1_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas>
        <Button Content="Wyświetl datę" FontSize="20" Canvas.Left="10" Canvas.Top="10" Height="69" 
                Width="286" HorizontalAlignment="Center" VerticalAlignment="Top" Click="ShowDate"
               />
        <Label x:Name="Info" FontSize="30" FontWeight="Bold" 
               Foreground="Green"
               Background="LightGreen"
               VerticalContentAlignment="Center"
               HorizontalContentAlignment="Center"
               RenderTransformOrigin="32.563,3.531" Canvas.Left="327" 
               Canvas.Top="10" Height="69" 
               Width="331" HorizontalAlignment="Center" 
               VerticalAlignment="Center"></Label>
        <TextBox Height="58" Canvas.Left="10"
                 x:Name="TextBox"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center" FontSize="24"
                   TextWrapping="Wrap" Text="" Canvas.Top="106" Width="286" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Button Content="Button" FontSize="28" Canvas.Left="10" Canvas.Top="178" Height="78" Width="306" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Button2_Click"/>
        <Label Content="Label" FontSize="28" x:Name="Label2"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"
               Canvas.Left="370" Canvas.Top="178" Height="78" Width="240" 
               HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Slider x:Name="Slider" Canvas.Left="10" Canvas.Top="322" 
                TickFrequency="1" IsSnapToTickEnabled="True"
                Minimum="0"
                Maximum="100"
                Width="306" 
                HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <Label  x:Name="ValueFromSlider" 
                Content="{Binding ElementName=Slider, Path=Value, 
 Mode=OneWay, StringFormat=wartość: {0:F0}}" 
                Canvas.Left="424" 
               Canvas.Top="300" FontSize="24" HorizontalAlignment="Left" 
               VerticalAlignment="Center" Width="108"/>
        <Label Content="{Binding ElementName=TextBox, Path=Text}" 
               FontSize="28" x:Name="Label3"
               
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Canvas.Left="370" Canvas.Top="106" Height="78" Width="240" 
               HorizontalAlignment="Center" VerticalAlignment="Top"/>
        <Button Content="Kontakty" Canvas.Left="583" Canvas.Top="368" Height="44" Width="207" Click="Button_Click"/>
    </Canvas>
</Window>
