<Window x:Class="cw1_wpf.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw1_wpf"
        mc:Ignorable="d"
        Title="ContactsWindow" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="295*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Vertical" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Height="Auto">
                <ListBox
                    x:Name="LbContacts"
                    d:ItemsSource="{d:SampleData ItemCount=5}" Width="500"/>
                <StackPanel Orientation="Vertical">
                    <Button Content="Dodaj" Width="200" Click="Button_Click"/>
                    <Button Content="Edytuj" Width="200"/>
                    <Button Content="Usuń" Width="200" Click="Button_Delete_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="1">
           <Grid.ColumnDefinitions>
                             <ColumnDefinition Width="Auto"/>
                             <ColumnDefinition Width="*"/>
           </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Label Content="Podaj imię:" Grid.Column="0" Grid.Row="0"
                   Padding="10"
                   HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16"></Label>
            <TextBox VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="0"></TextBox>
            <Label Padding="10" Content="Podaj nazwisko:" Grid.Column="0" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16"></Label>
            <TextBox VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="1"></TextBox>
            <Label Padding="10" Content="Podaj telefon:" Grid.Column="0" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16"></Label>
            <TextBox VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="2"></TextBox>
            <Button Grid.Row="3" Content="Anuluj" Height="30"></Button>
        </Grid>
    </Grid>
</Window>
