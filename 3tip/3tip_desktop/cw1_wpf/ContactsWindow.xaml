<Window x:Class="cw1_wpf.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw1_wpf"
        mc:Ignorable="d"
        Title="ContactsWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation="Vertical" Height="*">
            <Label Content="Kontakty" FontSize="32"
                   Background="AntiqueWhite"
                   HorizontalContentAlignment="Center"></Label>
            <StackPanel Orientation="Horizontal">
 <ListBox d:ItemsSource="{d:SampleData ItemCount=5}"/>
            </StackPanel>
           <StackPanel Orientation="Horizontal" Height="100">
               <Button Content="Dodaj" Width="200"></Button>
               <Button Content="Dodaj" Width="200"></Button>
           </StackPanel>
        </StackPanel>
    </Grid>
</Window>
