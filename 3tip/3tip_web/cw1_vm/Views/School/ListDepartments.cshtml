
@model List<cw1_vm.Models.ViewModels.DepartmentsStudent>
<h2>Lista klas</h2>
<table class="table table-striped">
    <thead>
        <th>Lp</th>
        <th>Nazwa</th>
        <th>Opis</th>
        <th>Ilość uczestników</th>
    </thead>
    <tbody>
        @{int lp = 0;}
        @foreach(var elem in Model)
        {
            lp++;
            <tr>
                <td>@lp</td>
                <td>@elem.ActuallDepartment.Name</td>
                <td>@elem.ActuallDepartment.Description</td>
                <td>@elem.StudentCount</td>
            </tr>
        }
    </tbody>
</table>