<Window x:Class="cw1_lists.AddNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw1_lists"
        mc:Ignorable="d"
        Title="Dodaj nową notatkę" Height="300" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Grid.Column="0" Content="Tytuł:" Margin="10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" Margin="10" 
                 FontSize="16" FontWeight="Bold"
                 HorizontalContentAlignment="Center"/>
        <Label Grid.Row="1" Grid.Column="0" Content="Treść:" Margin="10" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" Margin="10" AcceptsReturn="True" />
        <Label Grid.Row="2" Grid.Column="0" Content="Data:" Margin="10" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="2" Grid.Column="1" Margin="10" />
        <Button Grid.Row="3" Grid.Column="1" Content="Dodaj notatkę" Margin="10" />
    </Grid>
</Window>
