<Window x:Class="cw7_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw7_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="350">
   <StackPanel Orientation="Vertical" VerticalAlignment="Stretch">
       <TextBox x:Name="Count" FontSize="20"></TextBox>
       <Button x:Name="AddButton" Content="Generuj Liczby" FontSize="20" Click="GenerNumbers"></Button>
       
       <ListBox ScrollViewer.VerticalScrollBarVisibility="Auto" x:Name="List" Height="400"
                VerticalAlignment="Stretch"></ListBox>
   </StackPanel>
</Window>
