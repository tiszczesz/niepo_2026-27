<Window x:Class="zad2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad2"
        mc:Ignorable="d" ResizeMode="NoResize"
        Title="MainWindow" Height="300" Width="400">
    <Canvas>
        <Label Content="Imię" Canvas.Left="34" Canvas.Top="30" 
               HorizontalAlignment="Left" VerticalAlignment="Center" Width="130"/>
        <Label Content="Nazwisko" Canvas.Left="34" Canvas.Top="70" Width="130" 
               HorizontalAlignment="Center" VerticalAlignment="Center" 
               RenderTransformOrigin="0.467,2.921"/>
        <Label Content="Wiek" Canvas.Left="34" Canvas.Top="110" Width="130" 
               HorizontalAlignment="Center" VerticalAlignment="Center" 
               RenderTransformOrigin="0.467,2.921"/>
        <TextBox x:Name="firstname" Canvas.Left="149" TextWrapping="Wrap" Text="" Canvas.Top="34" 
                 Width="120" HorizontalAlignment="Left" VerticalAlignment="Center"/>
        <TextBox x:Name="lastname" Canvas.Left="149" TextWrapping="Wrap" Text="" Canvas.Top="74" 
                 Width="120"/>
        <TextBox x:Name="age" Canvas.Left="149" TextWrapping="Wrap" Text="" Canvas.Top="114" 
                 Width="120"/>
        <Button x:Name="Run" Content="Zatwierdź" Canvas.Left="34" Canvas.Top="150"
                HorizontalAlignment="Center" VerticalAlignment="Top" Width="235" 
                Height="26" Click="btn_Run" />
        <Label x:Name="Result" Content="Label" Canvas.Left="45" Canvas.Top="201"
               HorizontalAlignment="Left" VerticalAlignment="Center" Width="224"/>

    </Canvas>
</Window>
