<Window x:Class="cw6_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:cw6_wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Canvas>
        <Button Padding="5 "
          Width="200" Height="Auto" Canvas.Top="12" Canvas.Left="13" 
          Click="ShowDate">Pokaż datę</Button>
        <Label Canvas.Top="42" Canvas.Left="13" FontSize="20" x:Name="showLabel"
               Width="Auto">Witaj świecie!</Label>
        <Button Padding="5 "
            Width="200" Height="Auto" Canvas.Top="12" Canvas.Left="235" 
            Click="ShowTime" Content="Pokaż czas" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Label Canvas.Top="42" Canvas.Left="244" FontSize="20" x:Name="showTime"
            Width="Auto" Content="Tu będzie czas!" HorizontalAlignment="Left" 
            VerticalAlignment="Top"/>
        <Button Padding="5 "
            Width="200" Height="Auto" Canvas.Top="84" Canvas.Left="13" 
            Content="Ustaw kolor" HorizontalAlignment="Center"
            VerticalAlignment="Top" Click="ShowColor"/>
        <Rectangle x:Name="rec1"
            Height="43" Canvas.Left="235" Stroke="Black" Canvas.Top="84"
                   Fill="#44DD5689"
                   Width="200" HorizontalAlignment="Center" RadiusX="10" RadiusY="10"
                   VerticalAlignment="Top"/>
    </Canvas>
</Window>
